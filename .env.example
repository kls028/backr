# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# `supabase start` prints the API URL, anon key and service_role key. This
# project runs Supabase on 5442x rather than the default 5432x ports, because
# another local stack already occupies the defaults on this machine.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
# Which optional services start. "chain" includes the local Solana validator.
# Clear this to run the validator natively instead (see README > Toolchain);
# then also point SOLANA_RPC_URL back at host.docker.internal.
COMPOSE_PROFILES=chain

# The validator wipes its ledger on boot. Keep this true: a program preloaded
# at genesis can only be swapped by restarting, so a rebuilt program would
# otherwise never take effect.
VALIDATOR_RESET=true

# ---------------------------------------------------------------------------
# Backend (services/api) — consumed by docker compose
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54422/postgres

SUPABASE_URL=http://host.docker.internal:54421
# Only set this if your project still uses a legacy HS256 JWT secret. Modern
# projects use asymmetric signing keys and the backend verifies via JWKS, in
# which case leave this blank.
SUPABASE_JWT_SECRET=

# Used when the API runs on the host. Inside compose this is overridden to
# http://validator:8899, because the validator is a sibling service there.
SOLANA_RPC_URL=http://host.docker.internal:8899
PROGRAM_ID=5dzttAFNMi3JNtBcBQzJWcyXwou4rN2z6KX5DitDSDHe

# Shared secret you configure on the Helius webhook and it echoes back in the
# Authorization header. The ingest route refuses all traffic while this is
# empty — it fails closed rather than accepting unauthenticated writes.
# Generate one with: openssl rand -hex 32
HELIUS_WEBHOOK_SECRET=

RECONCILE_INTERVAL_SECONDS=60
RECONCILE_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Frontend (apps/web) — Vite only exposes VITE_-prefixed vars to the browser.
# Anything here is public. Never put a service_role key in this section.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api
VITE_SOLANA_RPC_URL=http://localhost:8899

# ---------------------------------------------------------------------------
# Tooling — not read by the app
# ---------------------------------------------------------------------------
# Needed by scripts/ and CI to push migrations to the hosted staging project.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
HELIUS_API_KEY=
